POSTGRES_DB=headache_tracker
POSTGRES_USER=headache
POSTGRES_PASSWORD=headache
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# CSRF trusted origins must include the full scheme://host:port you reach the site on.
#   Dev (http):    http://localhost,http://127.0.0.1
#   LAN  (http):   http://192.168.1.10:8383
#   Public (https): https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Host domain the Caddy site is served under.
#   Dev/LAN: local IP or localhost;  Public: a real FQDN for auto-HTTPS
DOMAIN=localhost

# Public/reverse-proxy Caddy frontend port mappings (docker-compose.yml only).
# host:container for HTTP and HTTPS. HTTP root must NOT be 0 for local dev.
CADDY_PORT_HTTP=80
CADDY_PORT_HTTPS=443

DJANGO_IMAGE=ghcr.io/lucaangioloni/headache_tracker/backend:latest
CADDY_IMAGE=ghcr.io/lucaangioloni/headache_tracker/frontend:latest
